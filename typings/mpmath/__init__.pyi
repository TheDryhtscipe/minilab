"""Minimal type stubs for the parts of mpmath that minilab uses.

mpmath ships no type information, and pyright runs in strict mode, so every
mpmath name minilab touches is declared here. Add a name when code needs it.
"""

from collections.abc import Iterable
from contextlib import AbstractContextManager

type _Real = mpf | int | float

class mpf:
    # A tuple (man, exp) is the exact value man * 2**exp, rounded to the working precision.
    def __init__(self, x: mpf | int | float | str | tuple[int, int] = ...) -> None: ...
    @property
    def man(self) -> int: ...
    @property
    def exp(self) -> int: ...
    def __add__(self, other: _Real) -> mpf: ...
    def __radd__(self, other: _Real) -> mpf: ...
    def __sub__(self, other: _Real) -> mpf: ...
    def __rsub__(self, other: _Real) -> mpf: ...
    def __mul__(self, other: _Real) -> mpf: ...
    def __rmul__(self, other: _Real) -> mpf: ...
    def __truediv__(self, other: _Real) -> mpf: ...
    def __rtruediv__(self, other: _Real) -> mpf: ...
    def __pow__(self, other: _Real) -> mpf: ...
    def __rpow__(self, other: _Real) -> mpf: ...
    def __neg__(self) -> mpf: ...
    def __pos__(self) -> mpf: ...
    def __abs__(self) -> mpf: ...
    def __lt__(self, other: _Real) -> bool: ...
    def __le__(self, other: _Real) -> bool: ...
    def __gt__(self, other: _Real) -> bool: ...
    def __ge__(self, other: _Real) -> bool: ...
    def __eq__(self, other: object) -> bool: ...
    def __ne__(self, other: object) -> bool: ...
    def __hash__(self) -> int: ...
    def __float__(self) -> float: ...

class _Context:
    dps: int
    prec: int
    def workdps(self, n: int) -> AbstractContextManager[None]: ...

mp: _Context
inf: mpf

def log(x: _Real) -> mpf: ...
def exp(x: _Real) -> mpf: ...
def sqrt(x: _Real) -> mpf: ...
def fsum(terms: Iterable[_Real]) -> mpf: ...
def nstr(x: mpf, n: int = ...) -> str: ...
def isfinite(x: _Real) -> bool: ...
def ldexp(x: _Real, n: int) -> mpf: ...
